# =============================================================================
# Cafe — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the real values:
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored. THIS file (.env.local.example) is committed and
# must never contain real secrets.
#
# Legend:
#   [required]       App will not boot without it
#   [feature-gated]  Required for that feature only; app boots without it
#   [optional]       Safe to leave unset
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  [required]
# -----------------------------------------------------------------------------
# Dashboard → Project Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL          the project URL (public, safe to expose)
# NEXT_PUBLIC_SUPABASE_ANON_KEY     the anon key — RLS-enforced, safe to expose
# SUPABASE_SERVICE_ROLE_KEY         BYPASSES RLS. SERVER-ONLY. NEVER commit,
#                                   NEVER prefix with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Clerk  [required]
# -----------------------------------------------------------------------------
# Dashboard → API Keys
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  pk_test_… / pk_live_…  (public)
# CLERK_SECRET_KEY                   sk_test_… / sk_live_…  (server-only)
# CLERK_WEBHOOK_SIGNING_SECRET       whsec_…  — from the Clerk webhook
#                                    endpoint you create (see README, "Clerk")
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=


# -----------------------------------------------------------------------------
# Stripe  [required for payments]
# -----------------------------------------------------------------------------
# Dashboard → Developers → API keys        → STRIPE_SECRET_KEY (sk_…)
# Dashboard → Developers → Webhooks        → STRIPE_WEBHOOK_SECRET (whsec_…)
#
# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
#   (the CLI prints the whsec_… to use locally)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Google Gemini  [feature-gated: AI concierge]
# -----------------------------------------------------------------------------
# https://aistudio.google.com/apikey
#
# If unset, /api/ai/chat and /api/ai/admin-chat return 503 and the chat UI
# degrades to an "unavailable" message. Everything else keeps working.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Web Push  [feature-gated: browser push notifications]
# -----------------------------------------------------------------------------
# Generate a VAPID key pair once:
#   npx web-push generate-vapid-keys
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY   public half — safe to expose
# VAPID_PRIVATE_KEY              private half — SERVER-ONLY
# VAPID_SUBJECT                  a mailto: or https: URL identifying you
# PUSH_WEBHOOK_SECRET            shared secret the Supabase Database Webhook
#                                sends as `x-webhook-secret`; any long random
#                                string, e.g. `openssl rand -hex 32`
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# App origin  [required in production]
# -----------------------------------------------------------------------------
# Absolute origin used for Stripe success/cancel redirects and any future
# absolute-URL metadata (og:image, canonical).
#
# Local:       http://localhost:3000
# Production:  https://your-domain.example
#
# Leaving this unset in production makes Stripe redirect back to localhost.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# AI request logging  [optional]
# -----------------------------------------------------------------------------
# AI_LOG=1 emits one structured JSON line per AI request (surface, model,
# latency, outcome, token-ish char counts). Off unless explicitly set to "1".
#
# AI_LOG_IP_SALT salts the hash of a guest's IP so log lines can be correlated
# without storing the raw IP. Set any random string in production.
# -----------------------------------------------------------------------------
# AI_LOG=1
# AI_LOG_IP_SALT=


# -----------------------------------------------------------------------------
# Node environment  [set by the platform]
# -----------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js / Vercel / your host. You do not
# normally need to set it in .env.local.
# -----------------------------------------------------------------------------
# NODE_ENV=development